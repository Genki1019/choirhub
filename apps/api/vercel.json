{
  "buildCommand": "pnpm run build:vercel",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/v1/internal/cron/attendance-due", "schedule": "0 0 * * *" },
    { "path": "/api/v1/internal/cron/notifications-cleanup", "schedule": "0 1 * * *" },
    { "path": "/api/v1/internal/cron/org-purge", "schedule": "0 2 * * *" },
    { "path": "/api/v1/internal/cron/audit-logs-cleanup", "schedule": "0 3 * * *" }
  ]
}
